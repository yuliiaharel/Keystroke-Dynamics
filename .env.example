# Copy to .env and fill in real values for local development.
# Never commit the real .env file.
#
# `docker compose up --build` reads SESSION_SECRET, DEBUG, and
# ALLOWED_ORIGIN from here, but sets its own DATABASE_URL pointing at
# the `db` service -- DATABASE_URL below is only for running the app
# directly on the host (outside Docker), against Postgres on localhost.
#
# DEBUG=true is the out-of-the-box default so a clean clone starts
# with no edits; set DEBUG=false and a real SESSION_SECRET (not
# "change-me") for anything other than local development -- the app
# refuses to start otherwise.
#
# ENABLE_ACCOUNTS=false (the default below) is public-launch mode: no
# registration/login/profile routes or old account pages, and no
# database connection at all -- DATABASE_URL is ignored. The anonymous
# party game (/api/game/*) works either way and never touches
# Postgres. Set ENABLE_ACCOUNTS=true to run the account system too
# (needs DATABASE_URL pointing at a real Postgres).

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/keystroke_dynamics
SESSION_SECRET=change-me
DEBUG=true
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGIN=http://127.0.0.1:8000
ENABLE_ACCOUNTS=false
# Absolute, public HTTPS URL this app is reachable at once deployed --
# only used for link-preview metadata (Open Graph/Twitter tags). Not
# needed for local development.
PUBLIC_BASE_URL=
MAX_BODY_BYTES=100000
MAX_EVENTS=2000
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60.0

# In-memory anonymous-game store limits -- see game/store.py. Same
# single-process caveat as the rate limiters above.
GAME_PARTY_LIMIT=500
GAME_PLAYERS_PER_PARTY_LIMIT=12
GAME_ATTEMPTS_PER_PARTY_LIMIT=200
GAME_IDLE_EXPIRY_SECONDS=7200
GAME_RATE_LIMIT_MAX_ATTEMPTS=20
GAME_RATE_LIMIT_WINDOW_SECONDS=60.0
